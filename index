<script>
  // Calendly: abre el diagnóstico en popup y deja el enlace como fallback si el widget aún no cargó.
  const CALENDLY_URL = 'https://calendly.com/lawavegrowth/diagnostico-de-crecimiento';
  function openCalendly(event){
    if(event) event.preventDefault();
    try{
      if(window.Calendly && typeof window.Calendly.initPopupWidget === 'function'){
        window.Calendly.initPopupWidget({url: CALENDLY_URL});
        try{ if(typeof gtag === 'function') gtag('event', 'schedule_start', {event_category:'lead', event_label:'Calendly'}); }catch(e){}
        try{ if(typeof fbq === 'function') fbq('track', 'Contact'); }catch(e){}
        return false;
      }
    }catch(e){}
    window.location.href = CALENDLY_URL;
    return false;
  }

  // Conversion tracking en el contacto por email — solo dispara si GA4/Meta Pixel están instalados arriba
  document.querySelectorAll('a[href^="mailto:"]').forEach(link => {
    link.addEventListener('click', () => {
      try{ if(typeof gtag === 'function') gtag('event', 'contact_email', { event_category:'lead' }); }catch(e){}
      try{ if(typeof fbq === 'function') fbq('track', 'Contact'); }catch(e){}
    });
  });

  // FAQ accordion — abre/cierra cada pregunta y sincroniza el icono.
  document.querySelectorAll('.faq-item').forEach(function(item){
    var summary = item.querySelector('.faq-q');
    var answer = item.querySelector('.faq-a');
    if(!summary || !answer) return;

    summary.addEventListener('click', function(){
      // <details> maneja el estado [open] de forma nativa.
      window.setTimeout(function(){
        if(item.open){
          answer.style.maxHeight = answer.scrollHeight + 'px';
          item.classList.add('open');
        }else{
          answer.style.maxHeight = '0px';
          item.classList.remove('open');
        }
      }, 0);
    });

    item.addEventListener('toggle', function(){
      if(item.open){
        answer.style.maxHeight = answer.scrollHeight + 'px';
        item.classList.add('open');
      }else{
        answer.style.maxHeight = '0px';
        item.classList.remove('open');
      }
    });
  });

  // ripple effect on buttons — water-drop click
  document.querySelectorAll('.pill-btn').forEach(btn => {
    btn.addEventListener('click', function(e){
      const rect = this.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height) * 1.6;
      const ripple = document.createElement('span');
      ripple.className = 'ripple';
      ripple.style.width = ripple.style.height = size + 'px';
      ripple.style.left = (e.clientX - rect.left - size/2) + 'px';
      ripple.style.top = (e.clientY - rect.top - size/2) + 'px';
      this.appendChild(ripple);
      setTimeout(() => ripple.remove(), 650);
    });
  });

  // testimonials carousel
  const track = document.getElementById('tTrack');
  const dotsWrap = document.getElementById('tDots');
  if(track){
    const cards = track.querySelectorAll('.t-card');
    cards.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'c-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Ir al testimonio ' + (i+1));
      dot.addEventListener('click', () => scrollToCard(i));
      dotsWrap.appendChild(dot);
    });
    const dots = dotsWrap.querySelectorAll('.c-dot');

    function scrollToCard(i){
      track.scrollTo({ left: cards[i].offsetLeft - track.offsetLeft, behavior:'smooth' });
    }
    function currentIndex(){
      let idx = 0, min = Infinity;
      cards.forEach((c,i) => {
        const d = Math.abs(c.offsetLeft - track.scrollLeft);
        if(d < min){ min = d; idx = i; }
      });
      return idx;
    }
    function updateDots(){
      const idx = currentIndex();
      dots.forEach((d,i) => d.classList.toggle('active', i === idx));
    }
    track.addEventListener('scroll', () => { updateDots(); }, { passive:true });

    document.getElementById('tPrev').addEventListener('click', () => {
      scrollToCard(Math.max(0, currentIndex() - 1));
    });
    document.getElementById('tNext').addEventListener('click', () => {
      scrollToCard(Math.min(cards.length - 1, currentIndex() + 1));
    });

    // autoplay
    let autoplay = setInterval(() => {
      const next = (currentIndex() + 1) % cards.length;
      scrollToCard(next);
    }, 5000);
    track.addEventListener('mouseenter', () => clearInterval(autoplay));
    track.addEventListener('touchstart', () => clearInterval(autoplay), { passive:true });
  }

  // Sistema Ola: estado inicial sin descripción; el contenido aparece al seleccionar una etapa.
  const waveInitial = document.getElementById('waveInteractive');
  if(waveInitial) waveInitial.classList.add('wave-initial');

  // interactive Sistema Ola
  const waveInteractive=document.getElementById('waveInteractive');
  if(waveInteractive){
    const waveSteps=[...waveInteractive.querySelectorAll('.wave-step')];
    const wavePanels=[...waveInteractive.querySelectorAll('.wave-panel')];
    const waveProgress=document.getElementById('waveProgress');
    let currentIndex=-1;
    let userInteracted=false;

    function activateWave(index,focus=false){
      if(!waveSteps.length) return;
      index=Math.max(0,Math.min(index,waveSteps.length-1));
      currentIndex=index;

      waveSteps.forEach((btn,i)=>{
        const active=i===index;
        btn.classList.toggle('active',active);
        btn.classList.toggle('just-selected',active);
        btn.setAttribute('aria-selected',active?'true':'false');
        btn.setAttribute('tabindex',active?'0':'-1');
      });
      wavePanels.forEach((panel,i)=>{
        const active=i===index;
        panel.classList.toggle('active',active);
        panel.setAttribute('aria-hidden',active?'false':'true');
      });
      if(waveProgress){
        waveProgress.style.width=((index+1)/waveSteps.length*100)+'%';
      }
      if(focus) waveSteps[index].focus();
      window.setTimeout(()=>waveSteps[index]?.classList.remove('just-selected'),380);
    }

    // One delegated listener means taps work even on nested text/spans.
    waveInteractive.addEventListener('click',(event)=>{
      const button=event.target.closest('.wave-step');
      if(!button || !waveInteractive.contains(button)) return;
      event.preventDefault();
      userInteracted=true;
      waveInteractive.classList.remove('wave-initial');
      activateWave(waveSteps.indexOf(button));
    });

    waveSteps.forEach((button,index)=>{
      button.addEventListener('keydown',(event)=>{
        if(event.key==='ArrowRight'||event.key==='ArrowDown'){
          event.preventDefault();
          userInteracted=true;
          activateWave((index+1)%waveSteps.length,true);
        }else if(event.key==='ArrowLeft'||event.key==='ArrowUp'){
          event.preventDefault();
          userInteracted=true;
          activateWave((index-1+waveSteps.length)%waveSteps.length,true);
        }
      });
    });

    // No panel is shown initially. A panel appears only after the user selects a stage.
  }
  // nav shrink on scroll
  const headerEl = document.querySelector('header');
  window.addEventListener('scroll', () => {
    headerEl.classList.toggle('scrolled', window.scrollY > 20);
  });
</script>

<script>
/* Scroll Reveal Observer */
(function() {
    function initReveal() {
        var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });

        document.querySelectorAll('.reveal, .reveal-stagger').forEach(function(el) {
            observer.observe(el);
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
    } else {
        initReveal();
    }
})();

/* Wave Interactive is handled by the main interaction controller above. */

/* Compare Toggle */
(function() {
    var btn = document.getElementById('compareToggleBtn');
    var table = document.getElementById('compareTable');
    var icon = document.getElementById('compareIcon');
    if (!btn || !table) return;
    btn.addEventListener('click', function() {
        var open = table.style.maxHeight && table.style.maxHeight !== '0px';
        if (open) {
            table.style.maxHeight = '0px';
            table.style.overflow = 'hidden';
            btn.setAttribute('aria-expanded', 'false');
            if (icon) icon.textContent = '+';
        } else {
            table.style.maxHeight = table.scrollHeight + 'px';
            table.style.overflow = 'visible';
            btn.setAttribute('aria-expanded', 'true');
            if (icon) icon.textContent = '−';
        }
    });
})();

/* Google Reviews Carousel */
(function() {
    var track = document.getElementById('gTrack');
    var dotsWrap = document.getElementById('gDots');
    if (!track || !dotsWrap) return;
    var cards = track.querySelectorAll('.g-card');
    var total = cards.length;
    var current = 0;

    function goTo(i) {
        if (i < 0) i = 0; if (i >= total) i = total - 1;
        current = i;
        var card = cards[0];
        var gap = 20;
        var width = card ? card.offsetWidth + gap : track.offsetWidth;
        track.scrollTo({ left: width * i, behavior: 'smooth' });
        updateDots();
    }

    function updateDots() {
        dotsWrap.innerHTML = '';
        for (var i = 0; i < total; i++) {
            var dot = document.createElement('button');
            dot.className = 'c-dot' + (i === current ? ' active' : '');
            dot.setAttribute('aria-label', 'Reseña ' + (i + 1));
            dot.addEventListener('click', (function(idx) { return function() { goTo(idx); }; })(i));
            dotsWrap.appendChild(dot);
        }
    }

    // Snap scroll listener
    track.addEventListener('scroll', function() {
        clearTimeout(track._scrollTimer);
        track._scrollTimer = setTimeout(function() {
            var card = cards[0];
            var gap = 20;
            var width = card ? card.offsetWidth + gap : track.offsetWidth;
            var idx = Math.round(track.scrollLeft / width);
            if (idx !== current) { current = idx; updateDots(); }
        }, 100);
    }, {passive:true});

    updateDots();
})();
</script>

