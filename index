<style>
  :root{
    --bg:#000000;
    --panel:#0B0B0D;
    --panel-2:#101013;
    --line:rgba(255,255,255,0.09);
    --text:#FFFFFF;
    --muted:#9AA0AE;
    --blue:#0A84FF;
    --blue-2:#3FA9FF;
    --blue-dark:#0B5FE0;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:#000000; color:var(--text);
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  
    cursor:auto;}
  a{ text-decoration:none; color:inherit; }
  .wrap{ max-width:1100px; margin:0 auto; padding:0 24px; }
  .blue{
    background:linear-gradient(90deg, #0A84FF 0%, #6FD1FF 22%, #0B5FE0 45%, #3FA9FF 68%, #7FE0FF 85%, #0A84FF 100%);
    background-size:300% 100%;
    -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; color:transparent;
    animation:hueDrift 6s linear infinite;
    display:inline-block;
  }
  @keyframes hueDrift{
    0%{ background-position:0% 50%; }
    100%{ background-position:-300% 50%; }
  }

  .glow{
    position:fixed; top:-14%; left:50%;
    width:900px; height:600px; border-radius:50%;
    background:radial-gradient(ellipse at center, rgba(10,132,255,0.14) 0%, rgba(10,132,255,0.04) 45%, rgba(0,0,0,0) 72%);
    filter:blur(40px); pointer-events:none; z-index:0;
    animation:glowFloat 12s ease-in-out infinite;
  }

  /* dynamic dotted grid backdrop, very subtle */
  .grid-bg{
    position:fixed; inset:0; z-index:0; pointer-events:none;
    background-image:radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size:34px 34px;
    -webkit-mask-image:radial-gradient(ellipse 900px 500px at 50% 0%, #000 30%, transparent 75%);
    mask-image:radial-gradient(ellipse 900px 500px at 50% 0%, #000 30%, transparent 75%);
  }

  /* floating orb accents for extra motion */
  .orb{ position:fixed; z-index:0; border-radius:50%; filter:blur(50px); pointer-events:none; opacity:0.35; }
  .orb1{ width:340px; height:340px; top:8%; left:6%; background:radial-gradient(circle, rgba(10,132,255,0.5), transparent 70%); animation:orbFloat1 16s ease-in-out infinite; }
  .orb2{ width:280px; height:280px; top:38%; right:4%; background:radial-gradient(circle, rgba(63,169,255,0.4), transparent 70%); animation:orbFloat2 20s ease-in-out infinite; }
  @media(max-width:700px){
    .orb1{ width:200px; height:200px; filter:blur(34px); }
    .orb2{ width:170px; height:170px; filter:blur(34px); }
  }
  @keyframes orbFloat1{ 0%,100%{ transform:translate(0,0); } 50%{ transform:translate(40px,60px); } }
  @keyframes orbFloat2{ 0%,100%{ transform:translate(0,0); } 50%{ transform:translate(-50px,-40px); } }

  /* wave-shaped section edges — continuous shoreline feel */


  /* ripple effect on buttons — water-drop click */
  .pill-btn{ position:relative; }
  .ripple{
    position:absolute; border-radius:50%; background:rgba(255,255,255,0.55);
    transform:scale(0); pointer-events:none; animation:rippleOut 650ms ease-out forwards;
  }
  @keyframes rippleOut{ to{ transform:scale(1); opacity:0; } }
  @media (prefers-reduced-motion: reduce){ .ripple{ display:none; } }
  @keyframes glowFloat{
    0%,100%{ transform:translate(-50%,0) scale(1); }
    50%{ transform:translate(-48%,3%) scale(1.06); }
  }

  @keyframes fadeUp{
    from{ opacity:0; transform:translateY(26px); }
    to{ opacity:1; transform:translateY(0); }
  }
  @keyframes fadeIn{
    from{ opacity:0; }
    to{ opacity:1; }
  }
  @keyframes dotPulse{
    0%{ box-shadow:0 0 0 0 rgba(63,169,255,0.55); }
    70%{ box-shadow:0 0 0 9px rgba(63,169,255,0); }
    100%{ box-shadow:0 0 0 0 rgba(63,169,255,0); }
  }
  @keyframes floatY{
    0%,100%{ transform:translateY(0); }
    50%{ transform:translateY(-8px); }
  }
  @keyframes shimmerLine{
    0%{ background-position:-200% 0; }
    100%{ background-position:200% 0; }
  }



  /* button shine sweep */
  .pill-blue{ position:relative; overflow:hidden; }
  .pill-blue::after{
    content:''; position:absolute; top:0; left:-60%; width:40%; height:100%;
    background:linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
    transform:skewX(-20deg); transition:left .6s ease;
  }
  .pill-blue:hover::after{ left:130%; }

  .js-ready .hero-anim{
    opacity:0;
    transform:translateY(18px);
    animation:heroIn .72s cubic-bezier(.2,.7,.2,1) forwards;
  }
  .js-ready .hero-anim:nth-child(1){animation-delay:.08s;}
  .js-ready .hero-anim:nth-child(2){animation-delay:.18s;}
  .js-ready .hero-anim:nth-child(3){animation-delay:.30s;}
  .js-ready .hero-anim:nth-child(4){animation-delay:.42s;}
  @keyframes heroIn{to{opacity:1;transform:none;}}
  /* nav on scroll */
  header nav{ transition:background .3s ease, box-shadow .3s ease, transform .3s ease; }
