  html,body,body *{font-family:'Inter',sans-serif !important;}

  /* Sistema Ola — widget interactivo (estado base: ningún panel visible hasta seleccionar una etapa) */
  .wave-step{ text-decoration:none; }
  .wave-step.active strong{color:#fff;}
  .wave-panel{display:none;position:relative;z-index:2;margin:28px auto 0;max-width:650px;padding:22px 24px;border:1px solid rgba(63,169,255,.18);border-radius:16px;background:rgba(7,10,15,.82);animation:panelIn .28s ease;}
  .wave-panel.active{display:block;}

  /* Base desktop del widget — antes solo existían los ajustes de mobile */
  .wave-interactive{
    position:relative; max-width:900px; margin:0 auto; padding:36px 40px 30px;
    background:var(--panel); border:1px solid var(--line); border-radius:24px; overflow:hidden;
  }
  .wave-progress{
    position:relative; height:4px; border-radius:999px; background:rgba(255,255,255,0.08);
    overflow:hidden; margin-bottom:34px; z-index:2;
  }
  .wave-progress span{
    display:block; height:100%; width:0%; border-radius:999px;
    background:linear-gradient(90deg,var(--blue-dark),var(--blue-2));
    transition:width .45s cubic-bezier(.2,.7,.2,1);
  }
  .wave-track{
    position:absolute; top:70px; left:40px; right:40px; height:150px;
    z-index:1; opacity:.35; pointer-events:none;
  }
  .wave-track svg{ width:100%; height:100%; display:block; }
  .wave-track svg path{ fill:none; stroke:var(--blue-2); stroke-width:2; }
  .wave-steps{
    position:relative; z-index:2; display:grid; grid-template-columns:repeat(4,1fr); gap:10px;
  }
  .wave-step{
    cursor:pointer; text-align:left; padding:14px 12px; border-radius:16px;
    display:flex; flex-direction:column; gap:6px; transition:background .25s ease, transform .2s ease;
  }
  .wave-step:hover{ background:rgba(255,255,255,0.04); }
  .wave-step.active{ background:rgba(10,132,255,0.1); }
  .wave-step.just-selected{ transform:scale(0.98); }
  .wave-number{
    width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-size:12px; font-weight:800; color:var(--muted); background:rgba(255,255,255,0.06);
    transition:background .25s ease, color .25s ease;
  }
  .wave-step.active .wave-number{ background:var(--blue-2); color:#00121f; }
  .wave-step strong{ font-size:14px; font-weight:800; letter-spacing:0.02em; color:var(--muted); text-transform:uppercase; transition:color .25s ease; }
  .wave-step small{ font-size:12px; color:var(--muted); font-weight:500; }
  .wave-hint{
    display:flex; align-items:center; gap:8px; justify-content:center; margin-top:22px;
    font-size:12px; color:var(--muted); font-weight:600; position:relative; z-index:2;
  }
  .wave-hint span{ color:var(--blue-2); animation:dotPulse 1.8s infinite; border-radius:50%; }
  .panel-kicker{font-size:9px;letter-spacing:.16em;color:var(--blue-2);font-weight:800;}
  .wave-panel h3{margin:7px 0 8px;font-size:18px;color:#fff;font-family:'Inter',sans-serif;font-weight:800;}
  .wave-panel p{margin:0;color:#9da5b3;font-size:12px;line-height:1.6;}
  @keyframes panelIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  .case-label{font-size:9px;letter-spacing:.14em;color:var(--blue-2);font-weight:800;margin-bottom:12px;}
  @media(max-width:760px){
    .wave-interactive{padding:20px 14px 16px;border-radius:18px;}
    .wave-track{top:24px;height:390px;left:26px;right:26px;opacity:.55;}
    .wave-track svg{height:100%;width:100%;transform:rotate(90deg) scaleY(.72);transform-origin:center;}
    .wave-steps{grid-template-columns:1fr;gap:4px;}
    .wave-step{display:grid;grid-template-columns:48px 1fr;grid-template-rows:auto auto;column-gap:13px;text-align:left;align-items:center;padding:7px 4px;}
    .wave-number{width:48px;height:48px;margin:0;grid-row:span 2;}
    .wave-panel{margin-top:17px;padding:18px 17px;}
    .wave-panel h3{font-size:16px;}
    .wave-panel p{font-size:11.5px;}
  }

  /* Growth flow + pricing hierarchy */
  .plan-kicker{
    font-size:10px; letter-spacing:.12em; color:var(--blue-2);
    font-weight:800; margin:0 0 8px;
  }
  .plan-fit{
    margin-top:18px; padding-top:14px; border-top:1px solid var(--line);
    color:#AEB4C1; font-size:11.5px; line-height:1.45;
  }
  .ola-flow{
    position:relative; display:grid; grid-template-columns:repeat(5,1fr);
    gap:18px; align-items:start; padding:38px 24px 28px;
  }
  .flow-line{
    position:absolute; left:9%; right:9%; top:66px; height:2px;
    background:linear-gradient(90deg, transparent, rgba(63,169,255,.75), rgba(63,169,255,.25), transparent);
    box-shadow:0 0 12px rgba(63,169,255,.25);
  }
  .flow-step{
    position:relative; z-index:1; text-align:center;
    min-width:0;
  }
  .flow-num{
    display:flex; align-items:center; justify-content:center;
    width:48px; height:48px; margin:0 auto 20px; border-radius:50%;
    background:#080B10; border:1px solid rgba(63,169,255,.55);
    color:var(--blue-2); font-size:11px; font-weight:800;
    box-shadow:0 0 20px rgba(63,169,255,.10);
  }
  .flow-step strong{
    display:block; font-size:11px; letter-spacing:.08em; color:#fff;
    margin-bottom:7px;
  }
  .flow-step > span:last-child{
    display:block; font-size:11px; color:#9DA4B1; line-height:1.4;
  }
  @media(max-width:760px){
    .ola-flow{grid-template-columns:1fr; gap:10px; padding:24px 20px;}
    .flow-line{left:44px; right:auto; top:48px; bottom:48px; width:2px; height:auto;
      background:linear-gradient(180deg, transparent, rgba(63,169,255,.7), transparent);}
    .flow-step{display:grid; grid-template-columns:48px 1fr; column-gap:16px; text-align:left; align-items:center;}
    .flow-num{grid-row:span 2; margin:0;}
  }

  /* SISTEMA OLA — neon wave divider */
  .ola-section{
    position:relative; padding:90px 0 70px; overflow:hidden;
    background:radial-gradient(ellipse at 50% 100%, rgba(10,132,255,0.1), transparent 70%);
  }
  .ola-content{ position:relative; z-index:2; text-align:center; }
  .ola-name{
    font-weight:900; letter-spacing:0.02em; font-size:clamp(30px,5.5vw,52px);
    text-transform:uppercase; margin-bottom:16px;
  }
  .ola-tag{ color:var(--muted); font-size:15px; max-width:460px; margin:0 auto; line-height:1.6; font-weight:500; }

  .ola-wave-wrap{
    position:absolute; left:0; right:0; bottom:0; height:150px; z-index:1;
    overflow:hidden; pointer-events:none;
  }
  .ola-svg{
    position:absolute; bottom:0; left:0; width:200%; height:150px;
    fill:none;
  }
  .ola-svg path{
    fill:none; stroke-linecap:round;
  }
  .ola-svg-back path{
    stroke:#0B5FE0; stroke-width:2.5; opacity:0.55;
    filter:drop-shadow(0 0 8px rgba(10,132,255,0.7)) drop-shadow(0 0 18px rgba(10,132,255,0.4));
  }
  .ola-svg-front path{
    stroke:#3FA9FF; stroke-width:2.5; opacity:0.85;
    filter:drop-shadow(0 0 6px rgba(63,169,255,0.85)) drop-shadow(0 0 16px rgba(63,169,255,0.5));
  }
  .ola-svg-back{ animation:olaFlowBack 14s linear infinite; }
  .ola-svg-front{ animation:olaFlowFront 9s linear infinite; }
  @keyframes olaFlowBack{ 0%{ transform:translateX(0); } 100%{ transform:translateX(-50%); } }
  @keyframes olaFlowFront{ 0%{ transform:translateX(-50%); } 100%{ transform:translateX(0); } }

  @media (prefers-reduced-motion: reduce){
    .ola-svg-back, .ola-svg-front{ animation:none; }
  }
  @media(max-width:600px){
    .ola-section{ padding:64px 0 50px; }
    .ola-wave-wrap{ height:100px; }
    .ola-svg{ height:100px; }
  }

  /* PRODUCT / SERVICE CARDS */
  .products{ display:flex; flex-direction:column; gap:20px; max-width:820px; margin:0 auto; }
  .pcard{
    position:relative; display:flex; gap:26px; align-items:center;
    background:var(--panel); border:1px solid var(--line); border-radius:26px; padding:26px;
    transition:transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s ease, border-color .35s ease;
  }
  .pcard:hover{ transform:translateY(-6px); border-color:rgba(63,169,255,0.35); box-shadow:0 20px 50px rgba(10,132,255,0.15); }
  .pcard.featured{ border-color:rgba(10,132,255,0.45); box-shadow:0 0 0 1px rgba(10,132,255,0.12); }
  .pcard.featured:hover{ box-shadow:0 0 0 1px rgba(10,132,255,0.2), 0 24px 55px rgba(10,132,255,0.22); }
  .ptag{
    position:absolute; top:-12px; left:26px; background:linear-gradient(180deg, var(--blue-2), var(--blue-dark));
    color:#fff; font-size:11px; font-weight:800; letter-spacing:0.04em; text-transform:uppercase;
    padding:6px 14px; border-radius:999px; box-shadow:0 4px 14px rgba(10,132,255,0.4);
  }
  .pthumb{
    flex-shrink:0; width:132px; height:132px; border-radius:18px;
    display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden;
    border:1px solid var(--line);
  }
  .pthumb.t1{ background:linear-gradient(145deg,#0C1524,#0A0F1C 60%, #071019); }
  .pthumb.t2{ background:linear-gradient(145deg,#0C1524,#081226 55%, #050B18); }
  .pthumb-glow{ position:absolute; width:110px; height:110px; border-radius:50%; background:radial-gradient(circle, rgba(10,132,255,0.35), transparent 70%); filter:blur(4px); animation:floatY 4s ease-in-out infinite; }
  .pthumb svg{ position:relative; z-index:1; transition:transform .35s ease; animation:floatY 5s ease-in-out infinite; }
  .pcard:hover .pthumb svg{ transform:scale(1.08) translateY(-2px); animation-play-state:paused; }
  .pinfo{ flex-grow:1; min-width:0; }
  .pinfo h3{ font-size:19px; font-weight:800; line-height:1.25; margin-bottom:8px; }
  .pinfo .desc{ color:var(--muted); font-size:13.5px; line-height:1.55; margin-bottom:14px; font-weight:500; }
  .price-row{ display:flex; align-items:baseline; gap:10px; margin-bottom:3px; flex-wrap:wrap; }
  .price-row .now{ font-size:24px; font-weight:900; color:var(--blue-2); }
  .price-row .was{ font-size:15px; color:var(--muted); text-decoration:line-through; font-weight:600; }
  .price-sub{ font-size:11.5px; color:var(--muted); letter-spacing:0.06em; text-transform:uppercase; font-weight:700; margin-bottom:16px; }
  .pcard .buy{ align-self:center; }
  @media(max-width:640px){
    .pcard{ flex-direction:column; align-items:flex-start; text-align:left; }
    .pcard .buy{ width:100%; }
  }

  /* included list under card (expandable feel, kept static) */
  .pfeat{ list-style:none; margin-top:16px; display:grid; grid-template-columns:1fr 1fr; gap:8px 18px; }
  .pfeat li{ font-size:13px; color:#C9CDD8; display:flex; gap:8px; align-items:flex-start; font-weight:500; }
  .pfeat li b{ color:var(--blue-2); flex-shrink:0; }
  @media(max-width:640px){ .pfeat{ grid-template-columns:1fr; } }

  /* STEPS */
  .steps{ display:grid; grid-template-columns:repeat(4,1fr); gap:18px; max-width:1000px; margin:0 auto; }
  @media(max-width:900px){ .steps{ grid-template-columns:1fr 1fr; } }
  @media(max-width:520px){ .steps{ grid-template-columns:1fr; } }
  .step{
    background:var(--panel); border:1px solid var(--line); border-radius:20px; padding:26px 22px;
    transition:transform .3s cubic-bezier(.2,.7,.2,1), border-color .3s ease, box-shadow .3s ease;
  }
  .step:hover{ transform:translateY(-5px); border-color:rgba(63,169,255,0.3); box-shadow:0 16px 36px rgba(10,132,255,0.12); }
  .step .n{
    font-weight:900; font-size:13px; letter-spacing:0.02em; text-transform:uppercase; color:var(--blue-2); background:rgba(10,132,255,0.12);
    width:fit-content; height:30px; padding:0 14px; border-radius:999px; display:flex; align-items:center; justify-content:center;
    margin-bottom:20px; transition:transform .3s ease, background .3s ease;
  }
  .step:hover .n{ transform:scale(1.1) rotate(-4deg); background:rgba(10,132,255,0.22); }
  .step h4{ font-size:15.5px; font-weight:800; margin-bottom:9px; text-transform:uppercase; letter-spacing:0.01em; }
  .step p{ font-size:13.3px; color:var(--muted); line-height:1.6; font-weight:500; }

  /* WHY STRIP */
  .why{ display:grid; grid-template-columns:repeat(3,1fr); gap:18px; max-width:1000px; margin:0 auto; }
  @media(max-width:760px){ .why{ grid-template-columns:1fr; } }
  .why-card{
    border:1px solid var(--line); border-radius:20px; padding:30px 26px; background:var(--panel); text-align:center;
    transition:transform .3s cubic-bezier(.2,.7,.2,1), border-color .3s ease, box-shadow .3s ease;
  }
  .why-card:hover{ transform:translateY(-5px); border-color:rgba(63,169,255,0.3); box-shadow:0 16px 36px rgba(10,132,255,0.12); }
  .why-card .metric{ font-weight:900; font-size:30px; color:var(--blue-2); margin-bottom:8px; transition:transform .3s ease; }
  .why-card:hover .metric{ transform:scale(1.08); }
  .why-card .label{ font-size:13.5px; color:var(--muted); line-height:1.55; font-weight:500; }

  /* FAQ */
  .faq{ max-width:720px; margin:0 auto; }
  .faq-item{ border-bottom:1px solid var(--line); }
  .faq-q{
    width:100%; text-align:left; background:none; border:none; color:var(--text);
    font-family:inherit; font-size:15.5px; font-weight:700; padding:22px 4px;
    display:flex; justify-content:space-between; align-items:center; cursor:pointer;
  }
  .faq-q .icon{ font-size:20px; color:var(--muted); transition:transform .25s; flex-shrink:0; margin-left:16px; }
  .faq-item.open .faq-q .icon{ transform:rotate(45deg); color:var(--blue-2); }
  .faq-a{ max-height:0; overflow:hidden; transition:max-height .3s ease; }
  .faq-a p{ padding:0 4px 22px; color:var(--muted); font-size:14px; line-height:1.7; max-width:620px; font-weight:500; }
  .faq-item > summary{ list-style:none; }
  .faq-item > summary::-webkit-details-marker{ display:none; }
  .faq-a{ max-height:0; overflow:hidden; transition:max-height .3s ease; }
  .faq-item[open] .faq-a{ max-height:500px; }

  /* FINAL CTA */
  .final{
    text-align:center; border:1px solid var(--line); border-radius:28px;
    padding:70px 28px; background:radial-gradient(ellipse at 50% 0%, rgba(10,132,255,0.16), rgba(0,0,0,0) 65%);
  }
  .final h2{ font-weight:900; text-transform:uppercase; font-size:clamp(26px,4.5vw,42px); line-height:1.05; margin-bottom:18px; }
  .final p{ color:var(--muted); margin-bottom:34px; font-size:16px; font-weight:500; }
  .trust-row{ display:flex; justify-content:center; gap:24px; margin-top:34px; flex-wrap:wrap; font-size:12.5px; color:var(--muted); font-weight:600; }
  .secondary-contact{ font-size:13.5px; color:var(--muted); margin-top:18px; font-weight:500; }
  .secondary-contact a{ color:var(--blue-2); font-weight:700; text-decoration:underline; text-underline-offset:3px; }

  @media (prefers-reduced-motion: reduce){
    *, *::before, *::after{ animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }
    .reveal, .r-item{ opacity:1 !important; transform:none !important; }
    .blue{ background-position:0% 50% !important; }
  }

  /* mobile sticky CTA */
  .sticky-cta{ display:none; }
  @media(max-width:760px){
    .sticky-cta{
      display:flex; position:fixed; bottom:0; left:0; right:0; z-index:70;
      padding:12px 16px calc(12px + env(safe-area-inset-bottom));
      background:rgba(6,6,8,0.85); backdrop-filter:blur(16px);
      border-top:1px solid var(--line);
    }
    .sticky-cta a{ width:100%; }
    body{ padding-bottom:78px; }
  }

  /* TESTIMONIALS CAROUSEL */
  .carousel-wrap{ position:relative; max-width:720px; margin:0 auto; }
  .carousel-track{ display:flex; overflow-x:auto; scroll-snap-type:x mandatory; gap:20px; padding:6px 4px 28px; scrollbar-width:none; -ms-overflow-style:none; }
  .carousel-track::-webkit-scrollbar{ display:none; }
  .t-card{
    scroll-snap-align:center; flex:0 0 100%; background:var(--panel); border:1px solid var(--line);
    border-radius:22px; padding:32px 30px; transition:border-color .3s ease, box-shadow .3s ease;
  }
  @media(min-width:600px){ .t-card{ flex:0 0 100%; } }
  .t-card:hover{ border-color:rgba(63,169,255,0.3); box-shadow:0 16px 40px rgba(10,132,255,0.12); }
  .t-stars{ color:#3FA9FF; font-size:15px; letter-spacing:2px; margin-bottom:16px; }
  .t-logo{ height:36px; max-width:140px; width:auto; object-fit:contain; object-position:left; margin-bottom:18px; display:block; }
  .t-quote{ font-size:16px; line-height:1.65; color:#E4E7F0; font-weight:500; margin-bottom:24px; }
  .t-person{ display:flex; align-items:center; gap:12px; }
  .t-avatar{
    width:42px; height:42px; border-radius:50%; flex-shrink:0;
    background:linear-gradient(135deg, var(--blue-2), var(--blue-dark));
    display:flex; align-items:center; justify-content:center; font-weight:800; font-size:15px; color:#fff;
  }
  .t-avatar.t-photo{ object-fit:cover; object-position:center; border:1px solid rgba(255,255,255,.12); }
  .t-name{ font-weight:700; font-size:14.5px; }
  .t-role{ font-size:12.5px; color:var(--muted); }
  .carousel-dots{ display:flex; justify-content:center; gap:8px; margin-top:6px; }
  .c-dot{ width:7px; height:7px; border-radius:50%; background:rgba(255,255,255,0.18); border:none; cursor:pointer; transition:background .25s, transform .25s; padding:0; }
  .c-dot.active{ background:var(--blue-2); transform:scale(1.3); }
  .carousel-arrow{
    position:absolute; top:50%; transform:translateY(-50%); width:40px; height:40px; border-radius:50%;
    background:rgba(255,255,255,0.05); border:1px solid var(--line); color:#fff; cursor:pointer;
    display:flex; align-items:center; justify-content:center; font-size:16px; transition:background .2s;
    z-index:2;
  }
  .carousel-arrow:hover{ background:rgba(255,255,255,0.12); }
  .carousel-arrow.prev{ left:-52px; }
  .carousel-arrow.next{ right:-52px; }
  @media(max-width:820px){ .carousel-arrow{ display:none; } }

  /* POR QUÉ FUNCIONA — comparison diagram */
  .vs-wrap{
    display:grid; grid-template-columns:1fr auto 1fr; gap:0; align-items:center;
    max-width:920px; margin:0 auto;
  }
  .vs-col{
    background:var(--panel); border:1px solid var(--line); border-radius:22px; padding:32px 28px;
    transition:transform .3s ease, border-color .3s ease;
  }
  .vs-col:hover{ transform:translateY(-4px); }
  .vs-before{ border-color:rgba(255,255,255,0.09); }
  .vs-after{ border-color:rgba(63,169,255,0.35); box-shadow:0 0 0 1px rgba(10,132,255,0.1), 0 20px 50px rgba(10,132,255,0.1); }
  .vs-label{ font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:20px; color:var(--muted); }
  .vs-after .vs-label{ color:var(--blue-2); }
  .vs-list{ list-style:none; display:grid; gap:14px; }
  .vs-list li{ display:flex; gap:10px; align-items:flex-start; font-size:14px; line-height:1.5; color:#C9CDD8; font-weight:500; }
  .vs-x{ color:#EF4444; font-weight:800; flex-shrink:0; margin-top:1px; }
  .vs-check{ color:var(--blue-2); font-weight:800; flex-shrink:0; margin-top:1px; }
  .vs-divider{
    display:flex; align-items:center; justify-content:center; padding:0 20px;
  }
  .vs-divider span{
    width:52px; height:52px; border-radius:50%; background:linear-gradient(180deg,var(--blue-2),var(--blue-dark));
    display:flex; align-items:center; justify-content:center; font-weight:900; font-size:13px; color:#fff;
    box-shadow:0 8px 24px rgba(10,132,255,0.4);
  }
  @media(max-width:820px){
    .vs-wrap{ grid-template-columns:1fr; gap:16px; }
    .vs-divider{ padding:4px 0; }
  }

  /* COMPARISON TABLE */
  .compare-wrap{ max-width:820px; margin:36px auto 0; }
  .compare-toggle{ text-align:center; }
  .compare-toggle-btn{
    background:none; border:1px solid var(--line); color:#fff; font-family:inherit;
    font-size:14px; font-weight:700; padding:12px 22px; border-radius:999px; cursor:pointer;
    display:inline-flex; align-items:center; gap:8px; transition:background .2s, border-color .2s;
  }
  .compare-toggle-btn:hover{ background:rgba(255,255,255,0.05); border-color:rgba(255,255,255,0.2); }
  .compare-toggle-btn .icon{ transition:transform .25s; font-size:17px; }
  .compare-toggle-btn.open .icon{ transform:rotate(45deg); color:var(--blue-2); }
  .compare-table-wrap{ max-height:0; overflow:hidden; transition:max-height .4s ease; margin-top:22px; }
  .compare-table-wrap.open{ overflow-x:auto; }
  .compare-table{ width:100%; border-collapse:collapse; min-width:520px; background:var(--panel); border:1px solid var(--line); border-radius:16px; overflow:hidden; }
  .compare-table th, .compare-table td{ padding:14px 16px; text-align:center; font-size:13.5px; border-bottom:1px solid var(--line); }
  .compare-table td:first-child{ text-align:left; color:#C9CDD8; font-weight:500; }
  .compare-table th{ font-weight:800; font-size:13px; text-transform:uppercase; letter-spacing:0.03em; color:var(--muted); background:rgba(255,255,255,0.02); }
  .compare-table th.hl-col{ color:var(--blue-2); }
  .compare-table td.hl-col{ background:rgba(10,132,255,0.06); font-weight:700; }
  .compare-table .yes{ color:var(--blue-2); font-weight:700; }
  .compare-table .no{ color:var(--muted); }
  .compare-table tr:last-child td{ border-bottom:none; }
  .price-tr td{ font-weight:800; font-size:14.5px; color:#fff; }

  /* GROWTH VISUAL LEGACY STYLES — retained for compatibility */
  .chart-card{
    max-width:820px; margin:0 auto; background:var(--panel); border:1px solid var(--line);
    border-radius:22px; padding:32px 28px 20px;
  }
  .chart-legend{ display:flex; gap:18px; margin-bottom:18px; }
  .chart-legend-item{ display:flex; align-items:center; gap:8px; font-size:13px; color:var(--muted); font-weight:600; }
  .dot-legend{ width:9px; height:9px; border-radius:50%; background:var(--blue-2); display:inline-block; }
  .chart-wrap{ position:relative; width:100%; }
  #growthChart{ width:100%; height:auto; display:block; }
  #chartLine{ stroke-dasharray:1000; stroke-dashoffset:1000; transition:stroke-dashoffset 1.6s cubic-bezier(.2,.7,.2,1); }
  .chart-card.in #chartLine{ stroke-dashoffset:0; }
  .chart-card{ opacity:0; transform:translateY(28px); transition:opacity .7s ease, transform .7s ease; }
  .chart-card.in{ opacity:1; transform:translateY(0); }
  .chart-dot{ fill:#0b0f1a; stroke:#3FA9FF; stroke-width:2.5; cursor:pointer; transition:r .2s ease, fill .2s ease; }
  .chart-dot:hover, .chart-dot:focus{ fill:#3FA9FF; r:7; outline:none; }
  .chart-tooltip{
    position:absolute; pointer-events:none; background:#101014; border:1px solid var(--line);
    border-radius:10px; padding:8px 12px; font-size:12.5px; color:#fff; white-space:nowrap;
    opacity:0; transform:translate(-50%,-8px); transition:opacity .15s ease, transform .15s ease; z-index:5;
  }
  .chart-tooltip.show{ opacity:1; transform:translate(-50%,-14px); }
  .chart-tooltip b{ color:var(--blue-2); }
  .chart-xaxis{ display:flex; justify-content:space-between; font-size:11.5px; color:var(--muted); font-weight:600; padding:10px 4px 4px; }
  @media(max-width:600px){ .chart-xaxis span:nth-child(even){ opacity:0.4; } }
  @media(max-width:600px){
    .chart-card{ padding:22px 16px 14px; }
    .chart-tooltip{ font-size:11.5px; padding:7px 10px; max-width:180px; white-space:normal; }
  }

  /* GOOGLE REVIEWS */
  .g-summary{
    display:flex; align-items:center; justify-content:center; gap:14px; flex-wrap:wrap;
    margin-bottom:44px;
  }
  .g-badge{ display:flex; align-items:center; gap:10px; border:1px solid var(--line); background:var(--panel); padding:14px 22px; border-radius:16px; }
