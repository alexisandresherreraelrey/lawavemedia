  /* HERO */
  .hero{ position:relative; z-index:1; padding:64px 24px 40px; text-align:center; }
  .badge{
    display:inline-flex; align-items:center; gap:9px;
    border:1px solid var(--line); background:rgba(255,255,255,0.03);
    padding:9px 18px 9px 14px; border-radius:999px; font-size:13.5px; color:var(--muted);
    margin-bottom:36px;
  }
  .badge .dot{ width:7px; height:7px; border-radius:50%; background:var(--blue-2); animation:dotPulse 2s infinite; }
  .hero h1{
    font-weight:900; text-transform:uppercase; line-height:0.98; letter-spacing:-0.01em;
    font-size:clamp(42px, 8.5vw, 84px); max-width:920px; margin:0 auto 28px;
  }
  .hero p.sub{
    font-size:18px; color:var(--muted); max-width:520px; margin:0 auto 44px; line-height:1.6; font-weight:500;
  }
  .hero-ctas{ display:flex; gap:14px; justify-content:center; flex-wrap:wrap; margin-bottom:40px; }

  .hero-anim{ opacity:0; animation:fadeUp .8s cubic-bezier(.2,.7,.2,1) forwards; }
  .hero .badge.hero-anim{ animation-delay:.05s; }
  .hero h1.hero-anim{ animation-delay:.18s; }
  .hero p.sub.hero-anim{ animation-delay:.32s; }
  .hero-ctas.hero-anim{ animation-delay:.46s; }


