  .pill-blue{
    color:#fff;
    background:linear-gradient(180deg, var(--blue-2) 0%, var(--blue-dark) 100%);
    box-shadow:0 6px 24px rgba(10,132,255,0.45), inset 0 1px 0 rgba(255,255,255,0.3);
  }
  .pill-blue:hover{ filter:brightness(1.08); }
  .pill-outline{
    color:#fff; background:rgba(255,255,255,0.04);
    border:1px solid rgba(255,255,255,0.14);
  }
  .pill-outline:hover{ background:rgba(255,255,255,0.08); }
  .pill-sm{ padding:9px 22px; font-size:14px; }

  /* NAV */
  header{ position:sticky; top:0; z-index:60; padding:18px 20px 0; }
  nav{
    max-width:1100px; margin:0 auto; display:flex; align-items:center; justify-content:space-between;
    background:rgba(10,10,12,0.72); backdrop-filter:blur(16px);
